# ---- Server ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://belle:belle_dev_password@localhost:5432/belle?schema=public
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
APP_TIMEZONE=Africa/Addis_Ababa
APP_CURRENCY=ETB
BRAND_NAME=Belle Ethiopia
LOG_LEVEL=info
UPLOAD_DIR=uploads
# Refresh-cookie Secure flag. Defaults to true in production; set false only for plain-HTTP trials.
# COOKIE_SECURE=true
# Database used by the automated tests (created and migrated automatically; use a separate DB, never your real one)
TEST_DATABASE_URL=postgresql://belle:belle_dev_password@localhost:5432/belle_test?schema=public

# ---- Optional integrations (leave blank = disabled; nothing is simulated) ----
# Email (SMTP) - when blank, email notifications are NOT sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS provider - when blank, SMS notifications are NOT sent
SMS_PROVIDER=
SMS_API_KEY=
# Payments - requires real merchant onboarding with the provider
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_WEBHOOK_SECRET=
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_API_KEY=

# ---- Client ----
VITE_API_URL=http://localhost:4000/api/v1
